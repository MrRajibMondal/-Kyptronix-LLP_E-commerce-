# Copy this file to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/circuit-co

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=circuit_co_token

# Store settings (mirrors the frontend .env)
STORE_NAME=Circuit & Co.
CURRENCY=INR
GST_RATE=18
DELIVERY_FEE=49
FREE_DELIVERY_THRESHOLD=500

# Coupons — same pattern as the frontend: one env var per coupon.
# COUPON_<CODE>=<percent off>
COUPON_SAVE20=20
COUPON_WELCOME10=10
COUPON_FLAT15=15
COUPON_FESTIVE25=25
