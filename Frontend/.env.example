# Copy this file to .env and restart `npm run dev` after any change.
#
# COUPONS
# Every coupon is one env var: VITE_COUPON_<CODE>=<percent off>
# The <CODE> becomes the code a shopper types in at checkout (case-insensitive).
# Add or remove as many as you like — the cart reads whatever is defined here,
# nothing is hardcoded in the source.
VITE_COUPON_SAVE20=20
VITE_COUPON_WELCOME10=10
VITE_COUPON_FLAT15=15
VITE_COUPON_FESTIVE25=25

# STORE
VITE_STORE_NAME=Circuit & Co.
VITE_CURRENCY=INR
